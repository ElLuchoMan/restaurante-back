# Archivo de ejemplo para configuración de variables de entorno
# Copia este archivo como .env y personaliza los valores

# JWT Secret - IMPORTANTE: Usa un valor seguro en producción
# Para desarrollo, puedes usar cualquier string consistente
# Ejemplo: JWT_SECRET=tu-secret-key-aqui-123456789
JWT_SECRET=

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=restaurante_db

# Firebase (opcional)
# FIREBASE_PROJECT_ID=el-fogon-de-maria

# VAPID para notificaciones push (opcional)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# Rate limiting (opcional)
# LOGIN_MAX_REQ_PER_MIN=10
# LOGIN_MAX_REQ_PER_MIN: intentos de login por minuto y por IP.
# RESERVA_CONSULTA_MAX_REQ_PER_MIN=10
# RESERVA_CONSULTA_MAX_REQ_PER_MIN: consultas de invitado (GET /reservas/consulta) por minuto y por IP.
# REFRESH_MAX_REQ_PER_MIN=30  (peticiones a /auth/refresh por minuto y por IP)
# Además: 5 fallos de contraseña por documento en 15 min => 429 con Retry-After
# (espera creciente, máx. 15 min; un login correcto reinicia el contador).

# Proxies de confianza que añaden su entrada a X-Forwarded-For (0-10).
# La IP del cliente es la entrada N desde el final (el primer valor lo controla
# el cliente y se ignora). 2 = Render (Cloudflare + proxy de Render); 0 = sin
# proxy (desarrollo local: se usa la IP de la conexión).
# TRUSTED_PROXY_HOPS=2
