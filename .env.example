# Archivo de ejemplo de variables de entorno para desarrollo local
# Copia este archivo a .env y llena los valores reales

# JWT Secret (generar uno seguro para producción)
JWT_SECRET=tu-jwt-secret-aqui

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=tu-password-aqui
DB_NAME=restaurante_db

# VAPID para notificaciones push
# Generar en: https://web-push-codelab.glitch.me/ o con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=tu-vapid-public-key-aqui
VAPID_PRIVATE_KEY=tu-vapid-private-key-aqui
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# Firebase (opcional)
FIREBASE_PROJECT_ID=el-fogon-de-maria

# Flags de desarrollo
SKIP_WEB_RUN=0
SKIP_CRON=0
