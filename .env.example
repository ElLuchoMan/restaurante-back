# Archivo de ejemplo para configuración de variables de entorno
# Copia este archivo como .env y personaliza los valores

# JWT Secret - IMPORTANTE: Usa un valor seguro en producción
# Para desarrollo, puedes usar cualquier string consistente
# Ejemplo: JWT_SECRET=tu-secret-key-aqui-123456789
JWT_SECRET=

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=restaurante_db

# Firebase (opcional)
# FIREBASE_PROJECT_ID=el-fogon-de-maria

# VAPID para notificaciones push (opcional)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# Rate limiting (opcional)
# LOGIN_MAX_REQ_PER_MIN=10
